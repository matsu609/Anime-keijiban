{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anime-keijiban",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/thread/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "anime-keijiban",
    "database_id": "60548675-6b20-4447-bfa9-3d735960bb6c",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["7 * * * *"] }
}
